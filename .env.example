# COD2BOT secrets - copy to .env (chmod 600). Never commit .env.
#
# Shared secret between Eggdrop (cod2bot.tcl) and the backend API.
# If empty, the backend generates data/api.token on first start and
# cod2bot.tcl reads that file (recommended: leave it empty).
COD2BOT_API_TOKEN=

# Optional: overrides the project root autodetection
# COD2BOT_ROOT=/home/youruser/eggdrop/cod2bot
